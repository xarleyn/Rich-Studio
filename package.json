{
  "name": "rich-studio-dev",
  "private": true,
  "description": "Dev tools only: the editor itself is plain ES modules served as is, no build step.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test:render": "node tests/render_unit.mjs",
    "test:formats": "node tests/formats_unit.mjs",
    "test:i18n": "node tests/i18n_unit.mjs",
    "test:parity": "node tests/render_parity.mjs",
    "test:shots": "node tests/preview_shots.mjs",
    "test:e2e": "node tests/e2e_ui.mjs",
    "vendor:editor": "node scripts/vendor-code-editor.mjs",
    "test:source": "node scripts/vendor-code-editor.mjs --check && node tests/source_completion.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@lezer/highlight": "1.2.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "lit": "3.3.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  }
}
