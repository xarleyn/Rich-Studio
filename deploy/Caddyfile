# HTTPS for the landing and app: comma-separated STUDIO_DOMAINS (ports 80 and 443 open).
{$STUDIO_DOMAINS} {
	# Only explicitly configured hosts enter this block. Add www to STUDIO_DOMAINS
	# and DNS to obtain its certificate; the application host is not redirected.
	@canonical_www header_regexp canonical_www Host (?i)^www\.([^:]+)(?::[0-9]+)?$
	redir @canonical_www https://{re.canonical_www.1}{uri} 308

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# uploads up to MAX_UPLOAD_MB (50 by default) plus the form around them
	request_body {
		max_size 60MB
	}
	# the studio sets the Secure flag on its session cookie from X-Forwarded-Proto, which Caddy sends
	reverse_proxy rich-studio:8080
}
