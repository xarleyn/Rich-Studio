# Copy to deploy/.env. The bot token goes to deploy/secrets/tg_bot_token, not here.
# The domain Caddy serves (DNS A/AAAA record → this server)
STUDIO_DOMAIN=app.example.com
# Caddy serves both hosts; the app keeps sessions on its own subdomain.
STUDIO_DOMAINS=example.com, app.example.com
STUDIO_LANDING_URL=https://example.com
# on: публичный вход через Telegram. У @BotFather задайте /setdomain для этого домена.
STUDIO_PUBLIC=on
TG_BOT_USERNAME=YourBot
# ACCOUNT_STORAGE_MB=500
# Ограничения памяти compose.simple.yml; start.sh сам задаст 384m/96m на VPS с 1 ГБ RAM.
# APP_MEMORY_LIMIT=512m
# PROXY_MEMORY_LIMIT=128m
# Image tag from GHCR: main (the last manual run of the image workflow), a commit sha or a v* version
# STUDIO_TAG=main
TG_DEFAULT_CHAT=
TG_PREVIEW_CHAT=
# The Litestream replica and its S3 keys go to deploy/litestream.env (see litestream.env.example): the studio
# never sees them
# Dead man's switch: healthchecks.io check URL; it alerts you when the studio stops pinging
# DEADMAN_URL=https://hc-ping.com/<uuid>
# Everything else from ../.env.example works here too (RAW_API=off is a good idea on a server)
RAW_API=off
